{
  "name": "notes-app-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.js\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.js\" \"*.json\" \"*.mjs\" \"prisma/**/*.prisma\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.js\" \"*.json\" \"*.mjs\" \"prisma/**/*.prisma\"",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test test/unit",
    "test:integration": "npm run build && node --test test/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@prisma/client": "6.12.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.13",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-prisma": "5.0.0",
    "prisma": "6.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
